# Telegram-бот этой системы (новый бот у @BotFather)
BOT_TOKEN=123456:ABC...

# Кто имеет доступ. Несколько id через запятую.
ADMIN_IDS=7320923704

# Telegram API для Telethon (как в source/every_hour.py)
API_ID=31999582
API_HASH=d1126aadf79c595b641181fd4d5df2ea

# Autoposter HTTP API (должен быть запущен)
SENDER_API_URL=http://127.0.0.1:8787
SENDER_API_KEY=

TIMEZONE=Asia/Bishkek
START_HOUR=9
# Daily repeat для scheduled (секунды). Только Premium. 0 = без repeat.
# Без Premium система не шлёт schedule_repeat_period (иначе 403) и
# каждый день в NONPREMIUM_RESCHEDULE_HOUR переназначает слоты.
REPEAT_PERIOD=86400

# Час суточной перенастройки для аккаунтов без Premium.
# Пусто = START_HOUR - 1 (например 8 при START_HOUR=9).
# NONPREMIUM_RESCHEDULE_HOUR=8

# AI-маркетолог: тихий сбор каждые N мин + утренний брифинг.
# MARKETER_INTERVAL_MIN=20
# MARKETER_ENABLED=true
# MARKETER_MORNING_HOUR=7
# MARKETER_MORNING_MINUTE=40
# Цель плотность постов в чате (мин): 5–10
# DENSITY_TARGET_MIN=5
# DENSITY_TARGET_MAX=10

WEEKLY_HEALTH_DOW=mon
WEEKLY_HEALTH_HOUR=10

# Недоступные schedule-чаты: повтор каждые N дней, стоп после M попыток.
# Еженедельно (WEEKLY_HEALTH_*) счётчик сбрасывается и чаты проверяются снова.
# Premium 24h-repeat при этом не трогается.
SETUP_RETRY_DAYS=3
SETUP_MAX_ATTEMPTS=3
SETUP_RETRY_HOUR=11

# Online ping defaults (можно менять в боте: меню → Online).
# ONLINE_PING_* в .env больше не обязательны — настройки в SQLite.

# ИИ-оператор: цикл анализа по фактам каждые N минут (по умолчанию 30)
# MARKETER_INTERVAL_MIN=30
# SpamBot: перепроверять аккаунты каждые N часов (и сразу при подозрении)
# SPAM_RECHECK_HOURS=3

# Автопилот (меню → Автопилот): сам вступает в чаты, настраивает отправку,
# заносит баны в базу и пишет админу. Включается/выключается в боте.
# AUTOPILOT_INTERVAL_MIN=60          # как часто проход
# AUTOPILOT_JOIN_PER_TICK=3          # вступлений на аккаунт за проход (анти-Flood)
# AUTOPILOT_JOIN_PAUSE_MIN_SEC=20
# AUTOPILOT_JOIN_PAUSE_MAX_SEC=45
# AUTOPILOT_RETRY_HOURS=6            # бэкофф после неудачи: 6ч, 12ч, 24ч… максимум 48ч
# AUTOPILOT_MAX_JOIN_ATTEMPTS=5      # потом «сдался», нужна помощь
# AUTOPILOT_SENDER_REFRESH_HOURS=6

# Спамблок (@SpamBot). Нагрузка sender: 50% сразу → 25% через RAMP_1 ч → 0% (стоп) через RAMP_2 ч.
# После снятия — RECOVERY ч на 50%, дальше 100%. DEAD_STRIKES спамблоков → dead
# (sender выключен навсегда, остаётся только schedule). Счётчик обнуляется после DECAY дней без блока.
# SPAM_CHECK_HOURS=3
# SPAM_RAMP_HOURS_1=6
# SPAM_RAMP_HOURS_2=24
# SPAM_RECOVERY_HOURS=6
# SPAM_DEAD_STRIKES=3
# SPAM_STRIKE_DECAY_DAYS=30

# Ворота подписки: сколько чатов на аккаунт сканировать за проход и как часто перепроверять.
# GATE_CHECKS_PER_TICK=6
# GATE_RECHECK_HOURS=12

# Результативность аккаунтов: сколько людей пишут в личку за окно. Меньше LOW_THRESHOLD — «пишут мало»,
# ноль — «никто не пишет»: аккаунт попадает в «Для переоформления», в сводку автопилота уходит
# сообщение с mention. После кнопки «Переоформил» аккаунт не оценивается GRACE_DAYS дней.
# PERF_WINDOW_DAYS=7
# PERF_MIN_AGE_DAYS=7
# PERF_LOW_THRESHOLD=3
# PERF_CHECK_HOURS=12
# PERF_GRACE_DAYS=7
# PERF_RENOTIFY_DAYS=7
# NOTIFY_MENTION=@arxixx
