# Telegram-бот этой системы (новый бот у @BotFather)
BOT_TOKEN=123456:ABC...

# Кто имеет доступ. Несколько id через запятую.
ADMIN_IDS=7320923704

# Telegram API для Telethon (как в source/every_hour.py)
API_ID=31999582
API_HASH=d1126aadf79c595b641181fd4d5df2ea

# Autoposter HTTP API (должен быть запущен)
SENDER_API_URL=http://127.0.0.1:8787
SENDER_API_KEY=

TIMEZONE=Asia/Bishkek
START_HOUR=9
# Daily repeat для scheduled (секунды). Только Premium. 0 = без repeat.
# Без Premium система не шлёт schedule_repeat_period (иначе 403) и
# каждый день в NONPREMIUM_RESCHEDULE_HOUR переназначает слоты.
REPEAT_PERIOD=86400

# Час суточной перенастройки для аккаунтов без Premium.
# Пусто = START_HOUR - 1 (например 8 при START_HOUR=9).
# NONPREMIUM_RESCHEDULE_HOUR=8

# AI-маркетолог: тихий сбор каждые N мин + утренний брифинг.
# MARKETER_INTERVAL_MIN=20
# MARKETER_ENABLED=true
# MARKETER_MORNING_HOUR=7
# MARKETER_MORNING_MINUTE=40
# Цель плотность постов в чате (мин): 5–10
# DENSITY_TARGET_MIN=5
# DENSITY_TARGET_MAX=10

WEEKLY_HEALTH_DOW=mon
WEEKLY_HEALTH_HOUR=10

# Недоступные schedule-чаты: повтор каждые N дней, стоп после M попыток.
# Еженедельно (WEEKLY_HEALTH_*) счётчик сбрасывается и чаты проверяются снова.
# Premium 24h-repeat при этом не трогается.
SETUP_RETRY_DAYS=3
SETUP_MAX_ATTEMPTS=3
SETUP_RETRY_HOUR=11

# Online ping defaults (можно менять в боте: меню → Online).
# ONLINE_PING_* в .env больше не обязательны — настройки в SQLite.

# ИИ-оператор: цикл анализа по фактам каждые N минут (по умолчанию 30)
# MARKETER_INTERVAL_MIN=30
# SpamBot: перепроверять аккаунты каждые N часов (и сразу при подозрении)
# SPAM_RECHECK_HOURS=3
